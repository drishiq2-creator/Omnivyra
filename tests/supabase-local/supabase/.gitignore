# Generated by the Supabase CLI when the disposable CI stack starts (v3; review finding F16).
# The root .gitignore rule "supabase/.temp/" is anchored to the repository root and does not
# cover this nested workdir. A hosted link here (.temp/project-ref, .temp/pooler-url) is also
# refused by bootstrap.sh check-env.
.temp/
.branches/
.env
.env.*
